# Copy this file to .env only for local development. Never commit .env.
# Render receives the same values through its encrypted environment variables.
GEOPORTAL_DATABASE_URL=postgresql://postgres:REPLACE_WITH_SUPABASE_DATABASE_PASSWORD@db.PROJECT_REF.supabase.co:5432/postgres?sslmode=require
GEOPORTAL_STORAGE_DIR=runtime/geoportal
GEOPORTAL_ALLOW_LOCAL_UPLOADS=true
# Optional only when the app is backed by durable object storage for uploads.
# GEOPORTAL_UPLOAD_TOKEN=replace-with-a-long-random-secret
