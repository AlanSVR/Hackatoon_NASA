# Copia este archivo como .env solo si tu método de arranque carga variables;
# nunca subas .env ni pegues contraseñas en comandos, chat o control de versiones.
GEOPORTAL_DATABASE_URL=postgresql://geoportal_app:CAMBIAR_EN_SECRETO@127.0.0.1:5432/geoportal_db
# En producción usa un directorio fuera del repositorio y fuera de cualquier carpeta pública.
GEOPORTAL_STORAGE_DIR=C:\geoportal-private\assets
GEOPORTAL_MAX_UPLOAD_BYTES=524288000
GEOPORTAL_CHUNK_BYTES=8388608
# Define un token aleatorio para habilitar carga remota. Sin token, la carga queda desactivada.
GEOPORTAL_UPLOAD_TOKEN=
# Solo para una prueba explícita desde localhost; no activar al publicar.
GEOPORTAL_ALLOW_LOCAL_UPLOADS=false
